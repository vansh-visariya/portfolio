<script>
  const tocZone = document.querySelector('.toc-zone') as HTMLElement | null;
  const tocLinks = document.querySelectorAll('[data-toc]');

  function setActive(id: string) {
    tocLinks.forEach((el) => {
      if ((el as HTMLElement).dataset.toc === id) {
        el.classList.add('active');
      } else {
        el.classList.remove('active');
      }
    });
  }

  function showToc() {
    if (tocZone) tocZone.classList.add('visible');
  }

  const observer = new IntersectionObserver(
    (entries) => {
      let anyVisible = false;
      for (const entry of entries) {
        const id = entry.target.getAttribute('id');
        if (entry.isIntersecting && id) {
          setActive(id);
          anyVisible = true;
        }
      }
      if (anyVisible) showToc();
    },
    { threshold: 0.15, rootMargin: '-10% 0px' }
  );

  document.querySelectorAll('[data-section]').forEach((el) => {
    const section = el as HTMLElement;
    observer.observe(section);

    const resolveObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.setAttribute('data-resolved', '');
          resolveObserver.unobserve(section);
        }
      },
      { threshold: 0.1 }
    );
    resolveObserver.observe(section);
  });

  if (tocZone) {
    setTimeout(() => {
      const rect = tocZone.getBoundingClientRect();
      if (rect.top >= 0 && rect.bottom <= window.innerHeight) {
        tocZone.classList.add('visible');
      }
    }, 200);
  }
</script>
