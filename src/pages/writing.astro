---
import PaperLayout from '../layouts/PaperLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('writing');
const sorted = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<PaperLayout
  title="Writing — Vansh Visariya"
  description="Technical writing on AI, ML engineering, and agentic systems."
>
  <header class="page-header">
    <p class="back-link"><a href="/">&larr; Back to paper</a></p>
    <h1>Writing</h1>
    <p class="subtitle">
      The author&rsquo;s technical notes and essays on production ML, agentic systems, and
      the craft of building AI.
    </p>
  </header>

  <hr />

  {
    sorted.length === 0 ? (
      <p class="empty">No published writing yet. Work in progress.</p>
    ) : (
      <ol class="post-list">
        {sorted.map((post) => (
          <li class="post-item">
            <time datetime={post.data.date.toISOString().split('T')[0]} class="post-date">
              {post.data.date.toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'short',
                year: 'numeric',
              })}
            </time>
            <a href={`/writing/${post.id.replace('.mdx', '')}`} class="post-title">{post.data.title}</a>
            <p class="post-abstract">{post.data.abstract}</p>
          </li>
        ))}
      </ol>
    )
  }
</PaperLayout>

<style>
  .page-header {
    margin-bottom: 1.5rem;
  }

  .back-link {
    font-size: 0.82rem;
    margin-bottom: 1rem;
  }

  .page-header h1 {
    font-size: 2.2rem;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--ink-light);
    font-size: 0.92rem;
    text-align: justify;
    hyphens: auto;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0;
  }

  .post-item {
    margin-bottom: 2rem;
  }

  .post-date {
    display: block;
    font-size: 0.78rem;
    color: var(--ink-muted);
    margin-bottom: 0.2rem;
  }

  .post-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--ink);
    text-decoration: none;
  }

  .post-title:hover {
    color: var(--accent);
  }

  .post-abstract {
    font-size: 0.88rem;
    color: var(--ink-light);
    margin-top: 0.3rem;
    text-align: justify;
    hyphens: auto;
  }

  .empty {
    color: var(--ink-muted);
    margin-top: 2rem;
  }
</style>
