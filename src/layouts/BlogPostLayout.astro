---
import PaperLayout from './PaperLayout.astro';

interface Props {
  title: string;
  description?: string;
  date?: string;
}

const { title, description, date } = Astro.props;
---

<PaperLayout title={title} description={description}>
  <header class="post-header">
    <h1>{title}</h1>
    {date && <p class="post-date">{date}</p>}
  </header>
  <div class="post-body">
    <slot />
  </div>
  <hr />
  <p class="back-link">
    <a href="/">← Back to paper</a>
  </p>
</PaperLayout>

<style>
  .post-header {
    margin-bottom: 2.5rem;
  }

  .post-header h1 {
    font-size: 2.2rem;
    line-height: 1.3;
  }

  .post-date {
    color: var(--ink-muted);
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }

  .post-body {
    margin-bottom: 3rem;
  }

  .back-link {
    font-size: 0.85rem;
  }
</style>
